<Layouts.flash_group flash={@flash} />
<div class="flex flex-col items-center text-center px-10 py-20 bg-white min-h-[100dvh]">
  <h1 class="font-serif text-[clamp(32px,5vw,48px)] text-stone-900 leading-[1.15] max-w-[640px] mb-5 font-normal">
    <%= if @current_scope && Tasky.Accounts.Scope.student?(@current_scope) do %>
      Willkommen, <span class="text-sky-500">{@current_scope.user.firstname}</span>
    <% else %>
      <%= if @current_scope && Tasky.Accounts.Scope.admin_or_teacher?(@current_scope) do %>
        Willkommen, <span class="text-sky-500">{@current_scope.user.firstname}</span>
      <% else %>
        Willkommen bei <em class="italic text-sky-500">LearningLine</em>
      <% end %>
    <% end %>
  </h1>

  <p class="text-base text-stone-500 leading-[1.7] max-w-[480px] mb-9">
    <%= if @current_scope && Tasky.Accounts.Scope.student?(@current_scope) do %>
      Dein einfaches Aufgabenverwaltungssystem für das Studium. Verwalte deine Kurse, bearbeite Aufgaben und reiche Lösungen ein.
    <% else %>
      <%= if @current_scope && Tasky.Accounts.Scope.admin_or_teacher?(@current_scope) do %>
        Dein Werkzeug für effiziente Kursverwaltung. Erstelle Kurse, verwalte Aufgaben und behalte den Überblick über deine Studierenden.
      <% else %>
        Ein einfaches Aufgabenverwaltungssystem für Lehrkräfte und Studierende. Organisiere Kurse, verwalte Aufgaben und behalte den Fortschritt im Blick.
      <% end %>
    <% end %>
  </p>

  <%= if @current_scope do %>
    <%= cond do %>
      <% Tasky.Accounts.Scope.student?(@current_scope) -> %>
        <div class="w-full max-w-[640px] flex flex-col gap-4 mt-4">
          <%!-- Courses Card --%>
          <.link
            navigate={~p"/student/courses"}
            class="group bg-white rounded-[14px] border border-stone-100 overflow-hidden shadow-[0_1px_3px_rgba(0,0,0,0.07),0_1px_2px_rgba(0,0,0,0.04)] transition-all duration-150 hover:shadow-[0_4px_12px_rgba(0,0,0,0.1)] hover:border-sky-200"
          >
            <div class="p-6 flex items-start gap-4">
              <div class="w-12 h-12 rounded-[12px] flex items-center justify-center shrink-0 bg-sky-50 text-sky-500 group-hover:bg-sky-100 transition-colors duration-150">
                <.icon name="hero-academic-cap" class="w-6 h-6" />
              </div>
              <div class="flex-1">
                <h3 class="text-base font-semibold text-stone-800 mb-1.5 group-hover:text-sky-600 transition-colors duration-150">
                  Alle Kurse ansehen
                </h3>
                <p class="text-sm text-stone-500 leading-relaxed">
                  Greife auf deine eingeschriebenen Kurse zu und verwalte deine Lerneinheiten
                </p>
              </div>
              <.icon
                name="hero-arrow-right"
                class="w-5 h-5 text-stone-300 group-hover:text-sky-500 group-hover:translate-x-1 transition-all duration-150"
              />
            </div>
          </.link>
          <%!-- Exams Card --%>
          <.link
            navigate={~p"/student/exams"}
            class="group bg-white rounded-[14px] border border-stone-100 overflow-hidden shadow-[0_1px_3px_rgba(0,0,0,0.07),0_1px_2px_rgba(0,0,0,0.04)] transition-all duration-150 hover:shadow-[0_4px_12px_rgba(0,0,0,0.1)] hover:border-amber-200"
          >
            <div class="p-6 flex items-start gap-4">
              <div class="w-12 h-12 rounded-[12px] flex items-center justify-center shrink-0 bg-amber-50 text-amber-500 group-hover:bg-amber-100 transition-colors duration-150">
                <.icon name="hero-document-text" class="w-6 h-6" />
              </div>
              <div class="flex-1">
                <h3 class="text-base font-semibold text-stone-800 mb-1.5 group-hover:text-amber-600 transition-colors duration-150">
                  Alle Prüfungen ansehen
                </h3>
                <p class="text-sm text-stone-500 leading-relaxed">
                  Sieh alle Prüfungen, für die du eingeteilt bist, und deine Ergebnisse
                </p>
              </div>
              <.icon
                name="hero-arrow-right"
                class="w-5 h-5 text-stone-300 group-hover:text-amber-500 group-hover:translate-x-1 transition-all duration-150"
              />
            </div>
          </.link>
        </div>
      <% Tasky.Accounts.Scope.admin_or_teacher?(@current_scope) -> %>
        <div class="w-full max-w-[640px] flex flex-col gap-4 mt-4">
          <%!-- Courses Card --%>
          <.link
            navigate={~p"/courses"}
            class="group bg-white rounded-[14px] border border-stone-100 overflow-hidden shadow-[0_1px_3px_rgba(0,0,0,0.07),0_1px_2px_rgba(0,0,0,0.04)] transition-all duration-150 hover:shadow-[0_4px_12px_rgba(0,0,0,0.1)] hover:border-sky-200"
          >
            <div class="p-6 flex items-start gap-4">
              <div class="w-12 h-12 rounded-[12px] flex items-center justify-center shrink-0 bg-sky-50 text-sky-500 group-hover:bg-sky-100 transition-colors duration-150">
                <.icon name="hero-academic-cap" class="w-6 h-6" />
              </div>
              <div class="flex-1">
                <h3 class="text-base font-semibold text-stone-800 mb-1.5 group-hover:text-sky-600 transition-colors duration-150">
                  Kurse verwalten
                </h3>
                <p class="text-sm text-stone-500 leading-relaxed">
                  Erstelle und verwalte deine Kurse und Lerneinheiten
                </p>
              </div>
              <.icon
                name="hero-arrow-right"
                class="w-5 h-5 text-stone-300 group-hover:text-sky-500 group-hover:translate-x-1 transition-all duration-150"
              />
            </div>
          </.link>
          <%!-- Classes Card --%>
          <.link
            navigate={~p"/classes"}
            class="group bg-white rounded-[14px] border border-stone-100 overflow-hidden shadow-[0_1px_3px_rgba(0,0,0,0.07),0_1px_2px_rgba(0,0,0,0.04)] transition-all duration-150 hover:shadow-[0_4px_12px_rgba(0,0,0,0.1)] hover:border-purple-200"
          >
            <div class="p-6 flex items-start gap-4">
              <div class="w-12 h-12 rounded-[12px] flex items-center justify-center shrink-0 bg-purple-50 text-purple-500 group-hover:bg-purple-100 transition-colors duration-150">
                <.icon name="hero-users" class="w-6 h-6" />
              </div>
              <div class="flex-1">
                <h3 class="text-base font-semibold text-stone-800 mb-1.5 group-hover:text-purple-600 transition-colors duration-150">
                  Klassen verwalten
                </h3>
                <p class="text-sm text-stone-500 leading-relaxed">
                  Organisiere deine Studierenden in Klassen und Gruppen
                </p>
              </div>
              <.icon
                name="hero-arrow-right"
                class="w-5 h-5 text-stone-300 group-hover:text-purple-500 group-hover:translate-x-1 transition-all duration-150"
              />
            </div>
          </.link>
          <%!-- Students Card --%>
          <.link
            navigate={~p"/students"}
            class="group bg-white rounded-[14px] border border-stone-100 overflow-hidden shadow-[0_1px_3px_rgba(0,0,0,0.07),0_1px_2px_rgba(0,0,0,0.04)] transition-all duration-150 hover:shadow-[0_4px_12px_rgba(0,0,0,0.1)] hover:border-teal-200"
          >
            <div class="p-6 flex items-start gap-4">
              <div class="w-12 h-12 rounded-[12px] flex items-center justify-center shrink-0 bg-teal-50 text-teal-500 group-hover:bg-teal-100 transition-colors duration-150">
                <.icon name="hero-user-group" class="w-6 h-6" />
              </div>
              <div class="flex-1">
                <h3 class="text-base font-semibold text-stone-800 mb-1.5 group-hover:text-teal-600 transition-colors duration-150">
                  Lernende verwalten
                </h3>
                <p class="text-sm text-stone-500 leading-relaxed">
                  Alle Lernenden deiner Organisation einsehen und ihre Angaben bearbeiten
                </p>
              </div>
              <.icon
                name="hero-arrow-right"
                class="w-5 h-5 text-stone-300 group-hover:text-teal-500 group-hover:translate-x-1 transition-all duration-150"
              />
            </div>
          </.link>
          <%!-- Exams Card --%>
          <.link
            navigate={~p"/exams"}
            class="group bg-white rounded-[14px] border border-stone-100 overflow-hidden shadow-[0_1px_3px_rgba(0,0,0,0.07),0_1px_2px_rgba(0,0,0,0.04)] transition-all duration-150 hover:shadow-[0_4px_12px_rgba(0,0,0,0.1)] hover:border-amber-200"
          >
            <div class="p-6 flex items-start gap-4">
              <div class="w-12 h-12 rounded-[12px] flex items-center justify-center shrink-0 bg-amber-50 text-amber-500 group-hover:bg-amber-100 transition-colors duration-150">
                <.icon name="hero-document-text" class="w-6 h-6" />
              </div>
              <div class="flex-1">
                <h3 class="text-base font-semibold text-stone-800 mb-1.5 group-hover:text-amber-600 transition-colors duration-150">
                  Prüfungen verwalten
                </h3>
                <p class="text-sm text-stone-500 leading-relaxed">
                  Erstelle und verwalte Prüfungen mit Inhalten und Musterlösungen
                </p>
              </div>
              <.icon
                name="hero-arrow-right"
                class="w-5 h-5 text-stone-300 group-hover:text-amber-500 group-hover:translate-x-1 transition-all duration-150"
              />
            </div>
          </.link>
          <%!-- Admin-only cards: the Administration routes have no other entry point --%>
          <div :if={Tasky.Accounts.Scope.admin?(@current_scope)} class="flex flex-col gap-4">
            <div class="flex items-center gap-3 mt-2">
              <span class="text-[11px] font-semibold uppercase tracking-[0.08em] text-stone-400">
                Administration
              </span>
              <div class="flex-1 h-px bg-stone-100"></div>
            </div>
            <%!-- Organizations Card --%>
            <.link
              navigate={~p"/admin/organizations"}
              class="group bg-white rounded-[14px] border border-stone-100 overflow-hidden shadow-[0_1px_3px_rgba(0,0,0,0.07),0_1px_2px_rgba(0,0,0,0.04)] transition-all duration-150 hover:shadow-[0_4px_12px_rgba(0,0,0,0.1)] hover:border-emerald-200"
            >
              <div class="p-6 flex items-start gap-4">
                <div class="w-12 h-12 rounded-[12px] flex items-center justify-center shrink-0 bg-emerald-50 text-emerald-500 group-hover:bg-emerald-100 transition-colors duration-150">
                  <.icon name="hero-building-office-2" class="w-6 h-6" />
                </div>
                <div class="flex-1">
                  <h3 class="text-base font-semibold text-stone-800 mb-1.5 group-hover:text-emerald-600 transition-colors duration-150">
                    Organisationen verwalten
                  </h3>
                  <p class="text-sm text-stone-500 leading-relaxed">
                    Organisationen anlegen und Einladungslinks für Lehrpersonen ausgeben
                  </p>
                </div>
                <.icon
                  name="hero-arrow-right"
                  class="w-5 h-5 text-stone-300 group-hover:text-emerald-500 group-hover:translate-x-1 transition-all duration-150"
                />
              </div>
            </.link>
            <%!-- Users Card --%>
            <.link
              navigate={~p"/admin/users"}
              class="group bg-white rounded-[14px] border border-stone-100 overflow-hidden shadow-[0_1px_3px_rgba(0,0,0,0.07),0_1px_2px_rgba(0,0,0,0.04)] transition-all duration-150 hover:shadow-[0_4px_12px_rgba(0,0,0,0.1)] hover:border-indigo-200"
            >
              <div class="p-6 flex items-start gap-4">
                <div class="w-12 h-12 rounded-[12px] flex items-center justify-center shrink-0 bg-indigo-50 text-indigo-500 group-hover:bg-indigo-100 transition-colors duration-150">
                  <.icon name="hero-identification" class="w-6 h-6" />
                </div>
                <div class="flex-1">
                  <h3 class="text-base font-semibold text-stone-800 mb-1.5 group-hover:text-indigo-600 transition-colors duration-150">
                    Benutzer verwalten
                  </h3>
                  <p class="text-sm text-stone-500 leading-relaxed">
                    Lehrpersonen einer Organisation zuweisen und Lernende ihrer Klasse
                  </p>
                </div>
                <.icon
                  name="hero-arrow-right"
                  class="w-5 h-5 text-stone-300 group-hover:text-indigo-500 group-hover:translate-x-1 transition-all duration-150"
                />
              </div>
            </.link>
          </div>
        </div>
      <% true -> %>
        <div class="flex items-center gap-3 flex-wrap justify-center">
          <.link
            navigate={~p"/users/settings"}
            class="inline-flex items-center gap-2 bg-sky-500 text-white text-[15px] font-semibold px-7 py-3.5 rounded-[14px] shadow-[0_2px_8px_rgba(14,165,233,0.25)] transition-all duration-150 hover:bg-sky-600 active:scale-[0.98]"
          >
            Zu den Einstellungen
          </.link>
        </div>
    <% end %>
  <% else %>
    <div class="flex items-center gap-3 flex-wrap justify-center">
      <.link
        navigate={~p"/users/log-in"}
        class="inline-flex items-center gap-2 bg-sky-500 text-white text-[15px] font-semibold px-7 py-3.5 rounded-[14px] shadow-[0_2px_8px_rgba(14,165,233,0.25)] transition-all duration-150 hover:bg-sky-600 active:scale-[0.98]"
      >
        <svg
          width="16"
          height="16"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"
          />
        </svg>
        Anmelden
      </.link>
    </div>
  <% end %>

  <%= unless @current_scope do %>
    <p class="mt-5 text-[13px] text-stone-400 flex items-center gap-1.5">
      <svg
        width="14"
        height="14"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
        />
      </svg>
      Keine Kreditkarte erforderlich · Jetzt mit der Organisation beginnen
    </p>
  <% end %>
</div>
