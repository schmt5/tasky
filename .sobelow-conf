[
  verbose: false,
  private: false,
  # honor inline `# sobelow_skip` annotations (each carries a justification)
  skip: true,
  router: "lib/tasky_web/router.ex",
  # fail (non-zero exit) on medium+ findings so CI can gate on it
  exit: "medium",
  threshold: "medium",
  # Config.Headers: false positive. The :browser pipeline does set secure
  # browser headers, but through the private `put_csp_secure_browser_headers/2`
  # plug rather than a direct `put_secure_browser_headers` call — the CSP has to
  # be built at runtime because it depends on the storage adapter (see
  # `TaskyWeb.ContentSecurityPolicy`), and sobelow cannot follow the
  # indirection. Covered by test/tasky_web/content_security_policy_test.exs.
  ignore: ["Config.Headers"],
  ignore_files: []
]
